---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Eyebrow from '../../components/brand/Eyebrow.astro';

const all = await getCollection('neighborhoods');
const neighborhoods = all.sort((a, b) => {
  const order = ['west-bay-beach', 'west-end', 'sandy-bay', 'pristine-bay', 'french-harbour', 'coxen-hole'];
  return order.indexOf(a.data.slug) - order.indexOf(b.data.slug);
});

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Roatán Neighborhoods Guide',
  description: 'Compare Roatán\'s six neighborhoods by price, vibe, and buyer profile — from luxury West Bay Beach to affordable Coxen Hole.',
  url: 'https://www.tomasfigueroa.com/neighborhoods/',
  hasPart: neighborhoods.map(n => ({
    '@type': 'Place',
    name: n.data.title,
    url: `https://www.tomasfigueroa.com/neighborhoods/${n.data.slug}/`,
    description: n.data.seo.description,
  })),
};
---

<Base
  title="Roatán Neighborhoods Guide | The Agency Roatán"
  description="Six Roatán neighborhoods compared — from luxury West Bay Beach ($485K median) to affordable Coxen Hole ($155K). Find which area matches your goals."
  schema={schema}
>
  <section class="page-hero">
    <div class="container">
      <Eyebrow text="Where to Buy" />
      <h1>Roatán Neighborhoods</h1>
      <p class="hero-intro">
        Roatán has six distinct neighborhoods, each with its own character, price point, and buyer
        profile. From luxury beachfront condos in West Bay to the island's affordable capital at
        Coxen Hole, here's how they compare — and which one fits your goals.
      </p>
    </div>
  </section>

  <section class="neighborhoods-section">
    <div class="container">
      <div class="n-grid">
        {neighborhoods.map(n => {
          const d = n.data;
          return (
            <a href={`/neighborhoods/${d.slug}/`} class="n-card">
              <div class="n-card-top">
                <p class="n-card-eyebrow eyebrow">{d.vibe}</p>
                <h2 class="n-card-title type-chic">{d.title}</h2>
                <p class="n-card-tagline">{d.tagline}</p>
              </div>
              <div class="n-card-bottom">
                <div class="n-card-price">
                  <span class="price-label">Prices from</span>
                  <span class="price-value">{d.priceRange}</span>
                </div>
                <ul class="n-card-tags" aria-label="Best for">
                  {d.bestFor.slice(0, 3).map(tag => (
                    <li class="n-tag">{tag}</li>
                  ))}
                </ul>
                <div class="n-card-stats">
                  <div class="stat-pair">
                    <span class="stat-label">Median price</span>
                    <span class="stat-value">{d.marketStats.medianSalePrice}</span>
                  </div>
                  <div class="stat-pair">
                    <span class="stat-label">Rental yield</span>
                    <span class="stat-value">{d.marketStats.rentalYield}</span>
                  </div>
                  <div class="stat-pair">
                    <span class="stat-label">YoY trend</span>
                    <span class="stat-value stat-yoy">{d.marketStats.yoyTrend}</span>
                  </div>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="contact-band">
    <div class="container contact-inner">
      <div>
        <Eyebrow text="Get in Touch" />
        <h2 class="contact-title type-chic">Not Sure Which Neighborhood?</h2>
        <p class="contact-sub">
          Tell me your goals — lifestyle, rental income, budget — and I'll tell you which area
          makes sense for you.
        </p>
      </div>
      <div class="contact-actions">
        <a href="/contact/" class="btn-solid">Talk to Tomas</a>
        <a href="https://wa.me/50499999999" class="wa-link" target="_blank" rel="noopener noreferrer">WhatsApp</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-hero {
    padding-block: var(--space-16) var(--space-10);
    background: var(--plaster);
    border-bottom: var(--hairline);
  }

  .page-hero h1 {
    font-family: var(--font-sleek);
    font-size: clamp(var(--text-4xl), 5vw, var(--text-5xl));
    font-weight: 700;
    letter-spacing: var(--tracking-sleek);
    text-transform: uppercase;
    color: var(--iron);
    margin: var(--space-3) 0 0;
  }

  .hero-intro {
    font-size: var(--text-lg);
    color: var(--iron-60);
    max-width: 60ch;
    line-height: var(--leading-relaxed);
    margin-top: var(--space-4);
  }

  .neighborhoods-section {
    padding-block: var(--space-16) var(--space-24);
  }

  .n-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--space-6);
  }

  .n-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: var(--hairline);
    padding: var(--space-8);
    text-decoration: none;
    color: inherit;
    gap: var(--space-8);
    transition: border-color var(--duration-fast);
  }

  .n-card:hover {
    border-color: var(--iron);
  }

  .n-card-eyebrow {
    font-size: var(--text-xs);
    color: var(--agency-red);
    margin-bottom: var(--space-2);
  }

  .n-card-title {
    font-size: var(--text-3xl);
    color: var(--iron);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-3);
  }

  .n-card-tagline {
    font-size: var(--text-sm);
    color: var(--iron-60);
    line-height: var(--leading-relaxed);
  }

  .n-card-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .n-card-price {
    padding-top: var(--space-4);
    border-top: var(--hairline);
  }

  .price-label {
    display: block;
    font-family: var(--font-sleek);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-sleek);
    text-transform: uppercase;
    color: var(--iron-40);
    margin-bottom: var(--space-1);
  }

  .price-value {
    font-family: var(--font-text);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--iron);
  }

  .n-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .n-tag {
    font-family: var(--font-sleek);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-sleek);
    text-transform: uppercase;
    color: var(--iron-60);
    background: var(--plaster);
    padding: var(--space-1) var(--space-3);
    border: var(--hairline);
  }

  .n-card-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
    border-top: var(--hairline);
    padding-top: var(--space-4);
  }

  .stat-pair {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .stat-label {
    font-family: var(--font-sleek);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-sleek);
    text-transform: uppercase;
    color: var(--iron-40);
  }

  .stat-value {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--iron);
  }

  .stat-yoy {
    color: #2a7a3b;
  }

  /* ── Contact band ── */
  .contact-band {
    background: var(--iron);
    padding-block: var(--space-16);
  }

  .contact-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-12);
    flex-wrap: wrap;
  }

  .contact-band :global(.eyebrow-label),
  .contact-band :global(.eyebrow-plus) {
    color: rgba(255, 255, 255, 0.6);
  }

  .contact-title {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    color: var(--canvas);
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .contact-sub {
    font-size: var(--text-base);
    color: rgba(255, 255, 255, 0.7);
    max-width: 50ch;
    line-height: var(--leading-relaxed);
  }

  .contact-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
    flex-shrink: 0;
  }

  .btn-solid {
    display: inline-block;
    padding: var(--space-4) var(--space-8);
    background: var(--agency-red);
    color: var(--canvas);
    font-family: var(--font-sleek);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-sleek);
    text-transform: uppercase;
    font-weight: 700;
    text-decoration: none;
    transition: opacity var(--duration-fast);
  }

  .btn-solid:hover { opacity: 0.88; }

  .wa-link {
    font-family: var(--font-text);
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.7);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--duration-fast);
  }

  .wa-link:hover { color: var(--canvas); }

  @media (max-width: 768px) {
    .contact-inner { flex-direction: column; }
    .n-grid { grid-template-columns: 1fr; }
  }
</style>
