        <a href="https://savvycal.com/Tomas-Figueroa-24db422b/chat-with-tomas?d=30" target="_blank" rel="noopener noreferrer" class="btn-outline-light">Schedule a Strategy Call</a>
      </div>
    </div>
  </section>

