---
import Base from '../../layouts/Base.astro';
import Eyebrow from '../../components/brand/Eyebrow.astro';

const nodes = [
  {
    num: '01', name: 'West Bay', lifestyle: 'Beach Lifestyle',
    bestFor: 'Beach lifestyle, premium vacation rental logic, and recognizable resale.',
    buyerProfile: 'U.S. buyer who wants the easiest lifestyle and rental story.',
    typicalProduct: 'Beach condos, resort residences, and ocean-view homes.',
    watchout: 'Higher entry price, tighter inventory, and more competition.',
    priceRange: '$430–$650/sqft premium oceanfront',
    neighborhoodSlug: 'west-bay-beach',
  },
  {
    num: '02', name: 'West End', lifestyle: 'Walkable Village Lifestyle',
    bestFor: 'Walkable island lifestyle, diving culture, and authentic daily expat life.',
    buyerProfile: 'Lifestyle buyer or diver who wants community over resort amenities.',
    typicalProduct: 'Condos, small villas, and mixed-use commercial properties.',
    watchout: 'Less prime beach; some properties are further from the waterfront.',
    priceRange: '$350–$500/sqft mid-tier premium',
    neighborhoodSlug: 'west-end',
  },
  {
    num: '03', name: 'Sandy Bay', lifestyle: 'Quiet Reef Lifestyle',
    bestFor: 'Quiet hillside living with reef access and panoramic ocean views.',
    buyerProfile: 'Retiree or long-term resident who prioritizes privacy over walkability.',
    typicalProduct: 'Hillside homes, view condos, and emerging luxury developments.',
    watchout: 'Car-dependent; fewer walkable amenities than West End or West Bay.',
    priceRange: '$300–$500/sqft (varies with elevation and view)',
    neighborhoodSlug: 'sandy-bay',
  },
  {
    num: '04', name: 'Pristine Bay', lifestyle: 'Gated Resort Lifestyle',
    bestFor: 'Gated resort amenities, turnkey management, and golf or marina lifestyle.',
    buyerProfile: 'Buyer who values predictable infrastructure and operational simplicity.',
    typicalProduct: 'Resort villas, managed condos, and marina residences.',
    watchout: 'Higher HOA costs; gated environment limits the open island experience.',
    priceRange: '$400–$700/sqft for villas and condos',
    neighborhoodSlug: 'pristine-bay',
  },
  {
    num: '05', name: 'French Harbour & East', lifestyle: 'Emerging Lifestyle',
    bestFor: 'Lower entry price, authentic local character, and longer-horizon appreciation.',
    buyerProfile: 'Value investor comfortable with less mature tourist infrastructure.',
    typicalProduct: 'Land, homes, and early-stage projects with development upside.',
    watchout: 'Rental yields more variable; selective project quality; longer hold required.',
    priceRange: '$200–$400/sqft (wide variance by exact location)',
    neighborhoodSlug: 'french-harbour',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.tomasfigueroa.com/' },
      { '@type': 'ListItem', position: 2, name: 'Where to Buy in Roatán', item: 'https://www.tomasfigueroa.com/where-to-buy-in-roatan/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Roatán Lifestyle Nodes',
    description: 'Five lifestyle nodes across Roatán, Bay Islands, Honduras — each with a distinct character, price range, and buyer profile.',
    itemListElement: nodes.map((n, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'TouristAttraction',
        name: `${n.name} — ${n.lifestyle}`,
        description: n.bestFor,
        containedInPlace: { '@type': 'Place', name: 'Roatán, Bay Islands, Honduras' },
      },
    })),
  },
];
---

<Base
  title="Where to Buy in Roatán | The Agency Roatán"
  description="An overview of Roatán's five lifestyle nodes — West Bay, West End, Sandy Bay, Pristine Bay, and French Harbour & East. Compare lifestyles, price ranges, and buyer profiles before you choose."
  canonicalUrl="https://www.tomasfigueroa.com/where-to-buy-in-roatan/"
  schema={schema}
>

  <section class="wtb-hero">
    <div class="container">
      <Eyebrow text="Where to Buy in Roatán" />
      <h1 class="wtb-title type-chic">One island. Five lifestyles.</h1>
      <p class="wtb-sub">Roatán is not one market. Compare the island by lifestyle, location, product type, and buyer fit before you choose a property.</p>
    </div>
  </section>

  <!-- Comparison matrix -->
  <section class="comparison-section">
    <div class="container" style="max-width:1200px">
      <Eyebrow text="Compare All Five" />
      <h2 class="comparison-heading type-chic">Pick your lifestyle. Then pick your property.</h2>

      <!-- Mobile card list -->
      <div class="node-cards">
        {nodes.map(node => (
          <div class="node-card">
            <div class="node-header">
              <span class="node-num">{node.num}</span>
              <div>
                <p class="node-name type-chic">{node.name}</p>
                <p class="node-lifestyle">{node.lifestyle}</p>
              </div>
            </div>
            <div class="node-fields">
              {[
                { label: 'Best For', value: node.bestFor },
                { label: 'Typical Product', value: node.typicalProduct },
                { label: 'Watch Out', value: node.watchout, dim: true },
                { label: 'Price Range', value: node.priceRange, strong: true },
              ].map(f => (
                <div class="node-field">
                  <span class="field-label">{f.label}</span>
                  <span class:list={['field-value', f.dim && 'field-dim', f.strong && 'field-strong']}>{f.value}</span>
                </div>
              ))}
            </div>
            <a href={`/neighborhoods/${node.neighborhoodSlug}/`} class="node-link">Full neighborhood profile →</a>
          </div>
        ))}
      </div>

      <!-- Desktop table -->
      <div class="comparison-table-wrap">
        <table class="comparison-table">
          <thead>
            <tr class="thead-row">
              <th>Location</th>
              <th>Lifestyle</th>
              <th>Best For</th>
              <th>Typical Product</th>
              <th>Watch Out</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {nodes.map((node, i) => (
              <tr class:list={['tbody-row', i % 2 === 0 && 'row-alt']}>
                <td class="td-name">
                  <span class="td-num">{node.num}</span>
                  {node.name}
                </td>
                <td class="td-text">{node.lifestyle}</td>
                <td class="td-text">{node.bestFor}</td>
                <td class="td-text">{node.typicalProduct}</td>
                <td class="td-dim">{node.watchout}</td>
                <td class="td-link-cell">
                  <a href={`/neighborhoods/${node.neighborhoodSlug}/`} class="td-profile-link">Full profile →</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="wtb-cta">
    <div class="container" style="max-width:720px; text-align:center">
      <Eyebrow text="Next Step" />
      <h2 class="cta-heading type-chic">Want to walk through your options live?</h2>
      <p class="cta-sub">Every buyer's situation is different — budget, lifestyle intent, hold period, and risk appetite all shape which node makes sense. A 20-minute call covers your priorities and maps them to specific projects.</p>
      <div class="cta-buttons">
        <a href="https://savvycal.com/Tomas-Figueroa-24db422b/chat-with-tomas?d=30" target="_blank" rel="noopener noreferrer" class="btn-red">Schedule a Strategy Call →</a>
        <a href="/contact/" class="btn-outline">Download the Investor Briefing</a>
      </div>
      <p class="cta-disclaimer">Price ranges shown are indicative and based on publicly available market data as of early 2026. All figures are USD. Individual project pricing and availability subject to change. This page is for informational purposes only and does not constitute investment advice.</p>
    </div>
  </section>

</Base>

<style>
  .wtb-hero { background: var(--iron); padding-block: var(--space-16) var(--space-13); }
  .wtb-title { font-size: clamp(var(--text-4xl), 3.5vw, var(--text-5xl)); color: var(--canvas); margin: var(--space-3) 0 var(--space-4); }
  .wtb-sub { font-size: var(--text-sm); color: rgba(255,255,255,.6); line-height: var(--leading-relaxed); max-width: 66ch; margin: 0; }

  .comparison-section { background: var(--canvas); padding-block: var(--space-16); }
  .comparison-heading { font-size: clamp(var(--text-2xl), 2.5vw, var(--text-3xl)); color: var(--iron); margin: var(--space-3) 0 var(--space-8); }

  /* Mobile cards */
  .node-cards { display: flex; flex-direction: column; gap: var(--space-2); background: var(--plaster); }
  @media (min-width: 900px) { .node-cards { display: none; } }
  .node-card { background: var(--canvas); padding: var(--space-5); }
  .node-header { display: flex; align-items: baseline; gap: var(--space-3); margin-bottom: var(--space-4); }
  .node-num { font-family: var(--font-sleek); font-size: var(--text-xs); letter-spacing: var(--tracking-sleek); color: var(--agency-red); text-transform: uppercase; flex-shrink: 0; }
  .node-name { font-size: var(--text-xl); color: var(--iron); margin: 0; }
  .node-lifestyle { font-family: var(--font-sleek); font-size: var(--text-xs); letter-spacing: var(--tracking-sleek); text-transform: uppercase; color: var(--iron-40); margin: var(--space-1) 0 0; }
  .node-fields { display: flex; flex-direction: column; gap: var(--space-3); margin-bottom: var(--space-5); }
  .node-field { display: flex; flex-direction: column; gap: 2px; }
  .field-label { font-family: var(--font-sleek); font-size: 9px; letter-spacing: .14em; text-transform: uppercase; color: var(--iron-40); }
  .field-value { font-size: var(--text-sm); color: var(--iron-60); line-height: var(--leading-snug); }
  .field-dim { color: var(--iron-40); }
  .field-strong { color: var(--iron); font-weight: 700; }
  .node-link { font-family: var(--font-text); font-size: var(--text-xs); color: var(--iron-40); text-decoration: underline; }

  /* Desktop table */
  .comparison-table-wrap { display: none; overflow-x: auto; }
  @media (min-width: 900px) { .comparison-table-wrap { display: block; } }
  .comparison-table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
  .thead-row th {
    padding: var(--space-3) var(--space-4); text-align: left;
    font-family: var(--font-sleek); font-size: var(--text-xs);
    letter-spacing: var(--tracking-sleek); text-transform: uppercase; color: var(--iron-40);
    white-space: nowrap; border-bottom: 2px solid var(--agency-red);
  }
  .tbody-row { border-bottom: var(--hairline); }
  .row-alt { background: var(--plaster); }
  .td-name { padding: var(--space-4); color: var(--iron); font-family: var(--font-chic); font-size: var(--text-base); white-space: nowrap; }
  .td-num { display: block; font-family: var(--font-sleek); font-size: 9px; letter-spacing: .12em; color: var(--agency-red); text-transform: uppercase; margin-bottom: 2px; }
  .td-text { padding: var(--space-4); color: var(--iron-60); line-height: var(--leading-snug); }
  .td-dim { padding: var(--space-4); color: var(--iron-40); line-height: var(--leading-snug); }
  .td-link-cell { padding: var(--space-4); white-space: nowrap; }
  .td-profile-link { font-size: var(--text-xs); color: var(--iron-40); text-decoration: underline; }
  .td-profile-link:hover { color: var(--iron); }

  /* CTA */
  .wtb-cta { background: var(--iron); padding-block: var(--space-18); }
  .cta-heading { font-size: clamp(var(--text-2xl), 2.5vw, var(--text-3xl)); color: var(--canvas); margin: var(--space-3) 0 var(--space-5); }
  .cta-sub { font-size: var(--text-sm); color: rgba(255,255,255,.6); line-height: var(--leading-relaxed); margin: 0 0 var(--space-9); max-width: 55ch; margin-inline: auto; margin-bottom: var(--space-9); }
  .cta-buttons { display: flex; flex-wrap: wrap; gap: var(--space-4); justify-content: center; }
  .btn-red {
    display: inline-block; padding: var(--space-4) var(--space-8);
    background: var(--agency-red); color: var(--canvas);
    font-family: var(--font-sleek); font-size: var(--text-sm);
    letter-spacing: var(--tracking-sleek); text-transform: uppercase; font-weight: 700;
    text-decoration: none; transition: opacity .15s;
  }
  .btn-red:hover { opacity: .88; }
  .btn-outline {
    display: inline-block; padding: var(--space-4) var(--space-8);
    background: transparent; color: rgba(255,255,255,.75);
    font-family: var(--font-sleek); font-size: var(--text-sm);
    letter-spacing: var(--tracking-sleek); text-transform: uppercase; font-weight: 700;
    text-decoration: none; border: 1px solid rgba(255,255,255,.25); transition: border-color .15s;
  }
  .btn-outline:hover { border-color: rgba(255,255,255,.6); }
  .cta-disclaimer { font-size: var(--text-xs); color: rgba(255,255,255,.3); line-height: var(--leading-relaxed); margin-top: var(--space-10); }
</style>
