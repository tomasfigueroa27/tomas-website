---
import Base from '../../layouts/Base.astro';

const seo = {
  title: 'Roatán Real Estate Guides | The Agency Roatán',
  description: 'Practical guides for buying and selling property in Roatán — taxes, closing costs, ownership rules, financing, and more.',
};

const guides = [
  {
    category: 'Buying',
    items: [
      {
        title: 'Closing Costs in Roatán',
        description: 'What buyers and sellers actually pay at closing — transfer tax, legal fees, commission, VAT, and prorated items. Includes a live calculator.',
        href: '/buy/closing-costs-roatan/',
        badge: 'Calculator',
      },
    ],
  },
  {
    category: 'Selling',
    items: [
      {
        title: 'Capital Gains Tax & ZOLITUR',
        description: 'Every Bay Islands sale pays a 4% capital gains tax to ZOLITUR — on the net gain, not the sale price. How it\'s calculated, what the processing costs, and when funds are released.',
        href: '/guides/roatan-capital-gains-tax-zolitur/',
        badge: null,
      },
    ],
  },
];
---

<Base title={seo.title} description={seo.description}>

  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Resources</p>
      <h1>Roatán Real Estate Guides</h1>
      <p class="hero-intro">
        Practical, verified information for buyers and sellers in Roatán.
        Every figure is sourced to a statute, a closing statement, or direct experience.
      </p>
    </div>
  </section>

  <section class="guides-section">
    <div class="container">
      {guides.map(group => (
        <div class="guide-group">
          <h2 class="group-label eyebrow">{group.category}</h2>
          <div class="guide-list">
            {group.items.map(guide => (
              <a href={guide.href} class="guide-card">
                <div class="guide-card-body">
                  <div class="guide-card-top">
                    <h3 class="guide-card-title">{guide.title}</h3>
                    {guide.badge && <span class="guide-badge">{guide.badge}</span>}
                  </div>
                  <p class="guide-card-desc">{guide.description}</p>
                </div>
                <span class="guide-card-arrow" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

</Base>

<style>
  .page-hero {
    padding-block: var(--space-16) var(--space-10);
    background: var(--plaster);
    border-bottom: var(--hairline);
  }

  .page-hero h1 {
    font-family: var(--font-sleek);
    font-size: clamp(var(--text-4xl), 5vw, var(--text-5xl));
    font-weight: 700;
    letter-spacing: var(--tracking-sleek);
    text-transform: uppercase;
    color: var(--iron);
    margin: var(--space-3) 0 0;
  }

  .hero-intro {
    font-size: var(--text-lg);
    color: var(--iron-60);
    max-width: 60ch;
    line-height: var(--leading-relaxed);
    margin-top: var(--space-4);
  }

  .guides-section {
    padding-block: var(--space-16) var(--space-24);
  }

  .guide-group {
    margin-bottom: var(--space-16);
  }

  .guide-group:last-child {
    margin-bottom: 0;
  }

  .group-label {
    color: var(--iron-40);
    margin-bottom: var(--space-6);
  }

  .guide-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .guide-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    padding: var(--space-8);
    background: var(--plaster);
    text-decoration: none;
    transition: background var(--duration-fast);
  }

  .guide-card:hover {
    background: var(--iron-10);
  }

  .guide-card-body {
    flex: 1;
  }

  .guide-card-top {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .guide-card-title {
    font-family: var(--font-sleek);
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-sleek);
    text-transform: uppercase;
    color: var(--iron);
    font-weight: 700;
  }

  .guide-badge {
    font-family: var(--font-sleek);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-sleek);
    text-transform: uppercase;
    color: var(--canvas);
    background: var(--agency-red);
    padding: 2px 8px;
    font-weight: 600;
  }

  .guide-card-desc {
    font-size: var(--text-sm);
    color: var(--iron-60);
    line-height: var(--leading-relaxed);
    max-width: 64ch;
  }

  .guide-card-arrow {
    font-size: var(--text-xl);
    color: var(--iron-40);
    flex-shrink: 0;
    transition: color var(--duration-fast), transform var(--duration-fast);
  }

  .guide-card:hover .guide-card-arrow {
    color: var(--agency-red);
    transform: translateX(4px);
  }
</style>
