---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Eyebrow from '../../components/brand/Eyebrow.astro';

const allPosts = await getCollection('blog');
const posts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Roatán Real Estate Blog – The Agency Roatán',
  description: 'Market reports, buying guides, and local insight for anyone considering property in Roatán, Honduras.',
  publisher: { '@type': 'Organization', name: 'The Agency Roatán' },
  url: 'https://www.tomasfigueroa.com/blog/',
};
---

<Base
  title="Roatán Real Estate Blog | The Agency Roatán"
  description="Market reports, buying guides, and local insight for anyone considering property in Roatán, Honduras."
  schema={schema}
>
  <section class="page-hero">
    <div class="container">
      <Eyebrow text="Roatán Real Estate" />
      <h1>Market Reports & Guides</h1>
      <p class="hero-intro">
        Current data, clear analysis, and on-the-ground perspective for buyers,
        sellers, and investors in Roatán and the Bay Islands.
      </p>
    </div>
  </section>

  <section class="blog-section">
    <div class="container">
      <ul class="post-list">
        {posts.map(post => (
          <li>
            <a href={`/blog/${post.id}/`} class="post-card">
              {post.data.image && (
                <div class="post-image-wrap">
                  <img
                    src={post.data.image}
                    alt={post.data.title}
                    class="post-image"
                    width="640"
                    height="360"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
              <div class="post-body">
                <div class="post-meta">
                  <span class="post-category">{post.data.category}</span>
                  <time datetime={post.data.date.toISOString().slice(0,10)} class="post-date">
                    {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                </div>
                <h2 class="post-title">{post.data.title}</h2>
                <p class="post-excerpt">{post.data.excerpt}</p>
                <span class="post-read-more">Read more →</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .page-hero {
    padding-block: var(--space-16) var(--space-10);
    background: var(--plaster);
    border-bottom: var(--hairline);
  }

  .page-hero h1 {
    font-family: var(--font-sleek);
    font-size: clamp(var(--text-4xl), 5vw, var(--text-5xl));
    font-weight: 700;
    letter-spacing: var(--tracking-sleek);
    text-transform: uppercase;
    color: var(--iron);
    margin: var(--space-3) 0 0;
  }

  .hero-intro {
    font-size: var(--text-lg);
    color: var(--iron-60);
    max-width: 60ch;
    line-height: var(--leading-relaxed);
    margin-top: var(--space-4);
  }

  .blog-section {
    padding-block: var(--space-16) var(--space-24);
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .post-card {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 0;
    text-decoration: none;
    background: var(--plaster);
    transition: background var(--duration-fast);
  }

  .post-card:hover {
    background: var(--iron-10);
  }

  .post-image-wrap {
    overflow: hidden;
    aspect-ratio: 16/9;
    height: 100%;
  }

  .post-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-fast);
  }

  .post-card:hover .post-image {
    transform: scale(1.03);
  }

  .post-body {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .post-category {
    font-family: var(--font-sleek);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-sleek);
    text-transform: uppercase;
    color: var(--agency-red);
    font-weight: 700;
  }

  .post-date {
    font-family: var(--font-text);
    font-size: var(--text-xs);
    color: var(--iron-40);
  }

  .post-title {
    font-family: var(--font-chic);
    font-size: var(--text-xl);
    color: var(--iron);
    line-height: var(--leading-snug);
    margin: 0;
  }

  .post-excerpt {
    font-size: var(--text-sm);
    color: var(--iron-60);
    line-height: var(--leading-relaxed);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-read-more {
    font-family: var(--font-sleek);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-sleek);
    text-transform: uppercase;
    color: var(--iron-40);
    margin-top: auto;
    transition: color var(--duration-fast);
  }

  .post-card:hover .post-read-more {
    color: var(--agency-red);
  }

  @media (max-width: 640px) {
    .post-card {
      grid-template-columns: 1fr;
    }
    .post-image-wrap {
      aspect-ratio: 16/9;
      height: auto;
    }
  }
</style>
