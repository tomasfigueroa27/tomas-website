---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/brand/Eyebrow.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';

const devs = await getCollection('developments');
const featured = devs.slice(0, 3);

const PAGE_TITLE = 'Roatán Real Estate & New Developments | Tomás Figueroa – The Agency';
const PAGE_DESC  = 'Luxury homes, beachfront condos and pre-construction developments in Roatán, Bay Islands. Buyer and developer representation from Tomás Figueroa, The Agency – Roatán.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: PAGE_TITLE,
    description: PAGE_DESC,
    url: 'https://www.tomasfigueroa.com/',
    author: {
      '@type': 'Person',
      name: 'Tomás Figueroa',
      url: 'https://www.tomasfigueroa.com/about/',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'RealEstateAgent',
    name: 'The Agency – Roatán',
    url: 'https://www.tomasfigueroa.com',
    description: 'The Agency – Roatán advises individuals and companies buying, investing, or relocating to Roatán, Bay Islands. An independently owned and operated franchisee of The Agency, led by Tomás Figueroa.',
    areaServed: {
      '@type': 'Place',
      name: 'Roatán, Bay Islands, Honduras',
    },
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: '+50488483226',
      email: 'tomas.figueroa@theagencyre.com',
      contactType: 'sales',
      availableLanguage: ['English', 'Spanish'],
    },
    agent: {
      '@type': 'Person',
      name: 'Tomás Figueroa',
      url: 'https://www.tomasfigueroa.com/about/',
      description: 'Tomás Figueroa relocated from Chile to Roatán in 2021. He advises individuals and companies on buying, investing, and relocating to the Bay Islands through The Agency – Roatán.',
      knowsLanguage: ['en', 'es'],
      image: 'https://www.tomasfigueroa.com/images/tomas-figueroa.avif',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Why Buy in Roatán',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '2nd-largest barrier reef in the world', description: "Roatán sits on the Mesoamerican Barrier Reef, the world's second largest." },
      { '@type': 'ListItem', position: 2, name: '6 nonstop gateways from the U.S. and Canada', description: 'Direct flights from multiple North American cities. Market priced in USD.' },
      { '@type': 'ListItem', position: 3, name: 'Titled freehold to 3,000 m²', description: 'Foreign nationals hold fee-simple title in their own name under Honduran law.' },
      { '@type': 'ListItem', position: 4, name: 'English spoken island-wide', description: 'English is the working language of the Bay Islands real estate market.' },
    ],
  },
];
---

<Base
  title={PAGE_TITLE}
  description={PAGE_DESC}
  canonicalUrl="https://www.tomasfigueroa.com/"
  schema={schema}
  heroOverlap={true}
>
  <!-- ── 1. Hero (Iron / video) ── -->
  <section class="hero">
    <video
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
    >
      <source src="/videos/Tomas%20Figueroa%20-%20Roatan%2030%20Seg_compressed-2.mp4" type="video/mp4" />
    </video>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="container hero-content">
      <Eyebrow text="Global reach. Island fluency." />
      <h1 class="hero-title type-chic">Your Window to Roatán</h1>
      <p class="hero-sub lede">
        Luxury homes, beachfront condos and new developments in the Bay Islands
        — with Tomás Figueroa, The Agency – Roatán.
      </p>
      <div class="hero-actions">
        <Button href="/properties/" variant="solid" size="lg">Explore MLS</Button>
        <Button href="/new-developments/" variant="outline" size="lg" class="btn--canvas">View Developments</Button>
      </div>
    </div>
  </section>

  <!-- ── 2. About band (Canvas) ── -->
  <section class="cred-band">
    <div class="container cred-inner">
      <div class="cred-photo-col">
        <img
          src="/images/tomas-figueroa.avif"
          alt="Tomás Figueroa on Roatán"
          width="480"
          height="600"
          class="cred-photo"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="cred-copy">
        <p class="cred-body lede">
          I'm Tomás Figueroa. I came from Chile in 2021 with my wife and our three boys.
          I don't just sell real estate here — I've done what you're about to do: moved a
          family, bought a home, invested, and built a business on this island. With The
          Agency, we advise individuals and companies buying, investing, or relocating
          to Roatán.
        </p>
        <div class="cred-proof">
          <p class="cred-proof-items">
            <span>Top-producing team since 2024</span>
            <span class="cred-sep" aria-hidden="true">·</span>
            <span>60+ closings</span>
            <span class="cred-sep" aria-hidden="true">·</span>
            <span>USD 30M+ in volume</span>
            <span class="cred-sep" aria-hidden="true">·</span>
            <span>English &amp; Spanish</span>
          </p>
          <p class="cred-proof-source">Roatán MLS data, Jan 2024–Sep 2026 — top-producing team by closed transaction volume, Roatán, Bay Islands</p>
        </div>
        <a href="/about/" class="cred-link">More about how I work →</a>
      </div>
    </div>
  </section>

  <!-- ── 3. Three paths (Plaster) ── -->
  <section class="section section--plaster paths-section">
    <div class="container">
      <Eyebrow text="How I Can Help" />
      <div class="paths-grid">
        <a href="/properties/" class="path-card">
          <span class="path-label type-chic">Buy</span>
          <p class="path-desc">Browse MLS listings and off-market properties with a buyer's agent who knows what doesn't make it online.</p>
          <span class="path-cta">Browse properties →</span>
        </a>
        <a href="/sell-in-roatan/" class="path-card">
          <span class="path-label type-chic">Sell</span>
          <p class="path-desc">Priced right, marketed to the right buyers. Full-service listing from valuation to closing.</p>
          <span class="path-cta">Sell your property →</span>
        </a>
        <a href="/developers/" class="path-card">
          <span class="path-label type-chic">Develop</span>
          <p class="path-desc">Land, entitlements, pricing strategy and sales — from concept to sellout.</p>
          <span class="path-cta">Developer services →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ── 4. Why Roatán (Iron) ── -->
  <section class="section section--iron why-section">
    <div class="container">
      <Eyebrow text="Why Roatán" />
      <h2 class="section-title type-chic why-heading">Easy to reach. Easy to own.</h2>
      <div class="why-grid">
        <div class="why-item">
          <p class="why-number type-chic">2nd</p>
          <p class="why-label">Largest barrier reef in the world</p>
          <p class="why-source">NOAA / Global Coral Reef Atlas</p>
        </div>
        <div class="why-item">
          <p class="why-number type-chic">6</p>
          <p class="why-label">Nonstop gateways from the U.S. and Canada — priced in USD</p>
          <p class="why-source">Published airline schedules, 2026</p>
        </div>
        <div class="why-item">
          <p class="why-number type-chic">3,000 m²</p>
          <p class="why-label">Titled freehold, in your own name</p>
          <p class="why-source">Honduran Foreign Investment Law</p>
        </div>
        <div class="why-item">
          <p class="why-number type-chic">English</p>
          <p class="why-label">Spoken island-wide. Island pace, no traffic.</p>
          <p class="why-source">Bay Islands demographics</p>
        </div>
      </div>
      <div class="section-cta">
        <Button href="/roatan-market/" variant="outline" size="md" class="btn--canvas">Roatán Market Guide</Button>
      </div>
    </div>
  </section>

  <!-- ── 5. New Developments (Canvas) ── -->
  <section class="section featured-devs">
    <div class="container">
      <Eyebrow text="Pre-Sale Now Open" />
      <h2 class="section-title type-chic">New Developments</h2>
      <p class="section-intro lede">Explore the new projects that redefine island living.</p>
      {featured.length > 0 && (
        <div class="dev-grid">
          {featured.map(dev => {
            const d = dev.data;
            return (
              <a href={`/new-developments/${d.slug}/`} class="dev-card">
                <div class="dev-card-image" style={`background-image: url('${d.heroImage}')`}>
                  <Badge status={d.status} />
                </div>
                <div class="dev-card-body">
                  <p class="dev-card-area eyebrow">{d.area.replace(/-/g, ' ')}</p>
                  <h3 class="dev-card-title type-chic">{d.title}</h3>
                  <p class="dev-card-location">{d.location?.address ?? 'Roatán, Honduras'}</p>
                  {d.priceFrom && (
                    <p class="dev-card-price">Starting from USD ${d.priceFrom.toLocaleString()}</p>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      )}
      <div class="section-cta">
        <Button href="/new-developments/" variant="outline" size="md">See All Developments</Button>
      </div>
    </div>
  </section>

  <!-- ── 6. Market / Insights (Plaster) — hairline separates from Canvas above ── -->
  <section class="section section--plaster market-section">
    <div class="container">
      <Eyebrow text="Market Intelligence" />
      <h2 class="section-title type-chic">Know the numbers.</h2>
      <div class="market-guides">
        <a href="/buy/closing-costs-roatan/" class="market-guide-item">
          <span class="market-guide-title">Closing costs in Roatán</span>
          <span class="market-guide-sub">Transfer tax, legal fees and what to expect at the table</span>
          <span class="market-guide-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/guides/roatan-capital-gains-tax-zolitur/" class="market-guide-item">
          <span class="market-guide-title">Capital gains &amp; ZOLITUR</span>
          <span class="market-guide-sub">The 4% tax, how it is calculated, and what is exempt</span>
          <span class="market-guide-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/roatan-market/" class="market-guide-item">
          <span class="market-guide-title">Roatán market overview</span>
          <span class="market-guide-sub">Prices, trends and what is moving in 2026</span>
          <span class="market-guide-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ── 7. Get in Touch (Iron) ── -->
  <section class="section section--iron contact-section">
    <div class="container contact-inner">
      <div class="contact-text">
        <Eyebrow text="Get in Touch" />
        <h2 class="section-title contact-heading type-chic">Let's talk before you shortlist.</h2>
        <p class="contact-sub lede">
          Tell me what you're weighing — a property, a project, or whether Roatán
          makes sense at all. Twenty minutes, no pitch.
        </p>
        <p class="contact-response">I reply the same day, usually within a few hours (CST).</p>
      </div>
      <div class="contact-channels">
        <a
          href="https://wa.me/50488483226"
          class="wa-btn"
          target="_blank"
          rel="noopener noreferrer"
          data-event="whatsapp_click"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="22" height="22" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          WhatsApp
        </a>
        <Button
          href="https://savvycal.com/Tomas-Figueroa-24db422b/chat-with-tomas?d=20"
          variant="outline"
          size="lg"
          class="btn--canvas"
          target="_blank"
          rel="noopener noreferrer"
          data-event="book_call_click"
        >Book a 20-minute call</Button>
        <div class="contact-tertiary">
          <a href="mailto:tomas.figueroa@theagencyre.com" class="contact-tertiary-link">tomas.figueroa@theagencyre.com</a>
          <a href="tel:+50488483226" class="contact-tertiary-link">+504 8848-3226</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: calc(var(--nav-height) + var(--space-8));
    padding-bottom: var(--space-20);
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,.6) 0%, rgba(0,0,0,.15) 45%, rgba(0,0,0,.35) 100%);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .hero-content :global(.eyebrow-label) {
    font-family: var(--font-sleek);
    font-size: clamp(0.8125rem, 0.75rem + 0.2vw, 0.9375rem);
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--canvas);
    text-shadow: 0 1px 3px rgba(0,0,0,.45);
  }

  .hero-content :global(.eyebrow-plus) {
    color: var(--agency-red);
  }

  .hero-title {
    font-size: clamp(2.5rem, 5.4vw, 5rem);
    line-height: 1.02;
    max-width: 24ch;
    text-wrap: balance;
    color: var(--canvas);
  }

  .hero-sub {
    max-width: 44rem;
    font-size: clamp(1.0625rem, 0.95rem + 0.45vw, 1.375rem);
    line-height: 1.5;
    color: rgba(255,255,255,.85);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }

  :global(.btn--canvas) {
    color: var(--canvas) !important;
    border-color: var(--canvas) !important;
  }
  :global(.btn--canvas:hover) {
    background: var(--canvas) !important;
    color: var(--iron) !important;
  }

  /* ── About band (Canvas) ── */
  .cred-band {
    padding-block: var(--space-24);
    background: var(--canvas);
    border-top: 1px solid var(--iron-10);
  }

  .cred-inner {
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: var(--space-16);
    align-items: start;
  }

  .cred-photo {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    object-position: center top;
  }

  .cred-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding-top: var(--space-4);
  }

  .cred-body {
    color: var(--iron-80);
    max-width: 52ch;
  }

  .cred-proof {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-8);
    border-top: 2px solid var(--iron-20);
  }

  .cred-proof-items {
    font-family: var(--font-sleek);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-sleek);
    text-transform: uppercase;
    color: var(--iron);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    margin: 0;
  }

  .cred-sep { color: var(--iron-40); }

  .cred-proof-source {
    font-family: var(--font-text);
    font-size: var(--text-xs);
    color: var(--iron-40);
    font-style: italic;
    margin: 0;
  }

  .cred-link {
    font-family: var(--font-text);
    font-size: var(--text-sm);
    color: var(--iron);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--duration-fast);
    align-self: flex-start;
  }
  .cred-link:hover { color: var(--agency-red); }

  @media (max-width: 900px) {
    .cred-inner { grid-template-columns: 1fr; gap: var(--space-10); }
    .cred-photo-col { max-width: 320px; }
  }

  /* ── Section shared ── */
  .section { padding-block: var(--space-24); }
  .section--plaster { background: var(--plaster); }
  .section--iron { background: var(--iron); }

  /* Iron section text defaults */
  .section--iron .section-title { color: var(--canvas); }
  .section--iron :global(.eyebrow-label) { color: rgba(255,255,255,.60); }
  .section--iron :global(.eyebrow-plus) { color: var(--agency-red); }

  .section-title {
    font-size: clamp(var(--text-3xl), 4vw, var(--text-5xl));
    margin-top: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .section-intro {
    max-width: 72ch;
    color: var(--iron-80);
    margin-bottom: var(--space-12);
  }

  .section-cta { margin-top: var(--space-12); }

  /* ── Three paths — hairline separates adjacent Canvas (About) from Plaster ── */
  .paths-section {
    padding-block: var(--space-20);
    border-top: var(--hairline);
  }

  .paths-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .path-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-8);
    text-decoration: none;
    color: inherit;
    background: var(--canvas);
    border-top: 3px solid var(--agency-red);
    border-right: var(--hairline);
    border-bottom: var(--hairline);
    border-left: var(--hairline);
    transition: box-shadow var(--duration-fast);
  }
  .path-card:hover { box-shadow: var(--shadow-md); }

  .path-label {
    font-size: var(--text-3xl);
    color: var(--iron);
    line-height: 1;
  }

  .path-desc {
    font-family: var(--font-text);
    font-size: var(--text-sm);
    color: var(--iron-60);
    line-height: var(--leading-relaxed);
    flex: 1;
    margin: 0;
  }

  .path-cta {
    font-family: var(--font-text);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-sleek);
    text-transform: uppercase;
    color: var(--iron);
  }

  @media (max-width: 768px) {
    .paths-grid { grid-template-columns: 1fr; }
  }

  /* ── Why Roatán (Iron) ── */
  .why-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-8);
  }

  @media (max-width: 1023px) { .why-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 479px)  { .why-grid { grid-template-columns: 1fr; } }

  .why-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255,255,255,.15);
  }

  .why-number {
    font-size: clamp(var(--text-3xl), 4vw, var(--text-5xl));
    line-height: 1;
    color: var(--canvas);
  }

  .why-label {
    font-family: var(--font-sleek);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-sleek);
    text-transform: uppercase;
    color: var(--plaster);
    max-width: 22ch;
    line-height: 1.35;
  }

  .why-source {
    margin-top: auto;
    padding-top: var(--space-4);
    font-family: var(--font-text);
    font-size: var(--text-xs);
    color: rgba(255,255,255,.50);
    font-style: italic;
  }

  /* ── Dev cards ── */
  .dev-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-8);
  }

  .dev-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border: var(--hairline);
    transition: border-color var(--duration-fast);
  }
  .dev-card:hover { border-color: var(--iron); }

  .dev-card-image {
    height: 220px;
    background-size: cover;
    background-position: center;
    background-color: var(--plaster);
    display: flex;
    align-items: flex-start;
    padding: var(--space-4);
  }

  .dev-card-body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .dev-card-area { font-size: var(--text-xs); color: var(--agency-red); }
  .dev-card-title { font-size: var(--text-2xl); line-height: 1.2; }
  .dev-card-location { font-size: var(--text-sm); color: var(--iron-60); }

  .dev-card-price {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: var(--hairline);
    font-family: var(--font-text);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  /* ── Market / Insights ── hairline separates Canvas above from Plaster ── */
  .market-section { border-top: var(--hairline); }

  .market-guides {
    margin-top: var(--space-8);
    display: flex;
    flex-direction: column;
