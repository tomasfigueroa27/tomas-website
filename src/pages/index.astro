---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/brand/Eyebrow.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';

const devs = await getCollection('developments');
const featured = devs.slice(0, 3);

const PAGE_TITLE = 'Roatán Real Estate & New Developments | Tomás Figueroa – The Agency';
const PAGE_DESC  = 'Luxury homes, beachfront condos and pre-construction developments in Roatán, Bay Islands. Buyer and developer representation from Tomás Figueroa, The Agency – Roatán.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: PAGE_TITLE,
    description: PAGE_DESC,
    url: 'https://www.tomasfigueroa.com/',
    author: {
      '@type': 'Person',
      name: 'Tomás Figueroa',
      url: 'https://www.tomasfigueroa.com/about/',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'RealEstateAgent',
    name: 'The Agency – Roatán',
    url: 'https://www.tomasfigueroa.com',
    areaServed: {
      '@type': 'Place',
      name: 'Roatán, Bay Islands, Honduras',
    },
    agent: {
      '@type': 'Person',
      name: 'Tomás Figueroa',
      url: 'https://www.tomasfigueroa.com/about/',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Why Buy in Roatán',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '2nd-largest barrier reef in the world', description: "Roatán sits on the Mesoamerican Barrier Reef, the world's second largest." },
      { '@type': 'ListItem', position: 2, name: '6 nonstop gateways from the U.S. and Canada', description: 'Direct flights from multiple North American cities. Market priced in USD.' },
      { '@type': 'ListItem', position: 3, name: 'Titled freehold to 3,000 m²', description: 'Foreign nationals hold fee-simple title in their own name under Honduran law.' },
      { '@type': 'ListItem', position: 4, name: 'English spoken island-wide', description: 'English is the working language of the Bay Islands real estate market.' },
    ],
  },
];
---

<Base
  title={PAGE_TITLE}
  description={PAGE_DESC}
  canonicalUrl="https://www.tomasfigueroa.com/"
  schema={schema}
  heroOverlap={true}
>
  <!-- ── Hero ── -->
  <section class="hero">
    <video
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
    >
      <source src="/videos/Tomas%20Figueroa%20-%20Roatan%2030%20Seg_compressed-2.mp4" type="video/mp4" />
    </video>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="container hero-content">
      <Eyebrow text="Global reach. Island fluency." />
      <h1 class="hero-title type-chic">Your Window to Roatán</h1>
      <p class="hero-sub lede">
        Luxury homes, beachfront condos and new developments in the Bay Islands
        — with Tomás Figueroa, The Agency – Roatán.
      </p>
      <div class="hero-actions">
        <Button href="/properties/" variant="solid" size="lg">Explore MLS</Button>
        <Button href="/new-developments/" variant="outline" size="lg" class="btn--canvas">View Developments</Button>
      </div>
    </div>
  </section>

  <!-- ── New Developments ── first section: carries the keyword H2 + answer-first para ── -->
  <section class="section featured-devs">
    <div class="container">
      <Eyebrow text="Pre-Sale Now Open" />
      <h2 class="section-title type-chic">Roatán Luxury Real Estate &amp; New Developments</h2>
      <p class="section-intro lede">
        Roatán real estate spans luxury beachfront estates on West Bay, gated communities
        in Pristine Bay, and a growing pipeline of new developments across the Bay Islands.
        Whether you are buying a home, a rental property, or entering pre-construction,
        Tomás Figueroa provides full-service buyer and developer representation through The Agency.
      </p>
      {featured.length > 0 && (
        <div class="dev-grid">
          {featured.map(dev => {
            const d = dev.data;
            return (
              <a href={`/new-developments/${d.slug}/`} class="dev-card">
                <div class="dev-card-image" style={`background-image: url('${d.heroImage}')`}>
                  <Badge status={d.status} />
                </div>
                <div class="dev-card-body">
                  <p class="dev-card-area eyebrow">{d.area.replace(/-/g, ' ')}</p>
                  <h3 class="dev-card-title type-chic">{d.title}</h3>
                  <p class="dev-card-location">{d.location?.address ?? 'Roatán, Honduras'}</p>
                  {d.priceFrom && (
                    <p class="dev-card-price">Starting from USD ${d.priceFrom.toLocaleString()}</p>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      )}
      <div class="section-cta">
        <Button href="/new-developments/" variant="outline" size="md">See All Developments</Button>
      </div>
    </div>
  </section>

  <!-- ── Why Roatán ── -->
  <section class="section section--plaster why-section">
    <div class="container">
      <Eyebrow text="Why Roatán" />
      <h2 class="section-title type-chic">The Caribbean's Best-Kept Secret</h2>
      <div class="why-grid">
        <div class="why-item">
          <p class="why-number type-chic">2nd</p>
          <p class="why-label">Largest barrier reef in the world</p>
          <p class="why-source">NOAA / Global Coral Reef Atlas</p>
        </div>
        <div class="why-item">
          <p class="why-number type-chic">6</p>
          <p class="why-label">Nonstop gateways from the U.S. and Canada — priced in USD</p>
          <p class="why-source">Published airline schedules, 2026</p>
        </div>
        <div class="why-item">
          <p class="why-number type-chic">3,000 m²</p>
          <p class="why-label">Titled freehold, in your own name</p>
          <p class="why-source">Honduran Foreign Investment Law</p>
        </div>
        <div class="why-item">
          <p class="why-number type-chic">English</p>
          <p class="why-label">Spoken island-wide. Island pace, no traffic.</p>
          <p class="why-source">Bay Islands demographics</p>
        </div>
      </div>
      <div class="section-cta">
        <Button href="/roatan-market/" variant="outline" size="md">Roatán Market Guide</Button>
      </div>
    </div>
  </section>

  <!-- ── Contact Band ── -->
  <section class="section contact-band">
    <div class="container contact-band-inner">
      <div class="contact-band-text">
        <Eyebrow text="Get in Touch" />
        <h2 class="section-title type-chic">Ready to Start Your Search?</h2>
        <p class="contact-band-sub lede">
          I work exclusively in Roatán's luxury and new-development market.
          Let me find the right property for your goals.
        </p>
      </div>
      <div class="contact-band-actions">
        <Button href="/contact/" variant="solid" size="lg">Contact Tomas</Button>
        <a href="https://wa.me/50488483226" class="whatsapp-link" target="_blank" rel="noopener noreferrer" data-event="whatsapp_click">
          WhatsApp
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: calc(var(--nav-height) + var(--space-8));
    padding-bottom: var(--space-20);
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.55), transparent 60%);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .hero-title {
    font-size: clamp(2.5rem, 5.4vw, 5rem);
    line-height: 1.02;
    max-width: 24ch;
    text-wrap: balance;
    color: var(--canvas);
  }

  .hero-sub {
    max-width: 44rem;
    font-size: clamp(1.0625rem, 0.95rem + 0.45vw, 1.375rem);
    line-height: 1.5;
    color: rgba(255,255,255,.85);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }

  /* Canvas outline button variant for dark bg */
  :global(.btn--canvas) {
    color: var(--canvas) !important;
    border-color: var(--canvas) !important;
  }
  :global(.btn--canvas:hover) {
    background: var(--canvas) !important;
    color: var(--iron) !important;
  }

  /* ── Section shared ── */
  .section {
    padding-block: var(--space-24);
  }

  .section--plaster {
    background: var(--plaster);
  }

  .section-title {
    font-size: clamp(var(--text-3xl), 4vw, var(--text-5xl));
    margin-top: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .section-intro {
    max-width: 72ch;
    color: var(--iron-80);
    margin-bottom: var(--space-12);
  }

  .section-cta {
    margin-top: var(--space-12);
  }

  /* ── Dev cards ── */
  .dev-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-8);
  }

  .dev-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border: var(--hairline);
    transition: border-color var(--duration-fast);
  }

  .dev-card:hover { border-color: var(--iron); }

  .dev-card-image {
    height: 220px;
    background-size: cover;
    background-position: center;
    background-color: var(--plaster);
    display: flex;
    align-items: flex-start;
    padding: var(--space-4);
  }

  .dev-card-body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .dev-card-area {
    font-size: var(--text-xs);
    color: var(--agency-red);
  }

  .dev-card-title {
    font-size: var(--text-2xl);
    line-height: 1.2;
  }

  .dev-card-location {
    font-size: var(--text-sm);
    color: var(--iron-60);
  }

  .dev-card-price {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: var(--hairline);
    font-family: var(--font-text);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  /* ── Why Roatán ── */
  .why-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-8);
  }

  @media (max-width: 1023px) {
    .why-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 479px) {
    .why-grid { grid-template-columns: 1fr; }
  }

  .why-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-6);
    border-top: 2px solid var(--iron-20);
  }

  .why-number {
    font-size: clamp(var(--text-3xl), 4vw, var(--text-5xl));
    line-height: 1;
    color: var(--iron);
  }

  .why-label {
    font-family: var(--font-sleek);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-sleek);
    text-transform: uppercase;
    color: var(--iron);
    max-width: 22ch;
    line-height: 1.35;
  }

  .why-source {
    margin-top: auto;
    padding-top: var(--space-4);
    font-family: var(--font-text);
    font-size: var(--text-xs);
    color: var(--iron-40);
    font-style: italic;
  }

  /* ── Contact band ── */
  .contact-band {
    background: var(--iron);
  }

  .contact-band-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-12);
    flex-wrap: wrap;
  }

  .contact-band :global(.eyebrow-label),
  .contact-band :global(.eyebrow-plus) {
    color: rgba(255,255,255,.6);
  }

  .contact-band .section-title {
    color: var(--canvas);
    margin-bottom: var(--space-4);
  }

  .contact-band-sub {
    color: rgba(255,255,255,.7);
    max-width: 45ch;
  }

  .contact-band-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
    flex-shrink: 0;
  }

  .whatsapp-link {
    font-family: var(--font-text);
    font-size: var(--text-sm);
    color: rgba(255,255,255,.7);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--duration-fast);
  }
  .whatsapp-link:hover { color: var(--canvas); }

  @media (max-width: 768px) {
    .hero { padding-bottom: var(--space-16); }
    .hero-actions { flex-direction: column; }
    .contact-band-inner { flex-direction: column; }
  }
</style>
