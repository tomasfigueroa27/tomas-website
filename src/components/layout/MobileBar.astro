---
<!-- Fixed mobile CTA bar — hidden on desktop via CSS -->
<div class="mobile-bar" role="complementary" aria-label="Quick contact">
  <a
    href="https://wa.me/50488483226"
    class="mobile-bar-btn mobile-bar-btn--wa"
    data-event="whatsapp_click"
    rel="noopener noreferrer"
    target="_blank"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
    </svg>
    <span>WhatsApp</span>
  </a>
  <a
    href="/contact/"
    class="mobile-bar-btn mobile-bar-btn--book"
    data-event="calendar_click"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
      <line x1="16" y1="2" x2="16" y2="6"/>
      <line x1="8" y1="2" x2="8" y2="6"/>
      <line x1="3" y1="10" x2="21" y2="10"/>
    </svg>
    <span>Book a Call</span>
  </a>
</div>

<style>
  .mobile-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: var(--z-nav);
    display: none;
    height: 3.5rem;
  }

  @media (max-width: 767px) {
    .mobile-bar {
      display: flex;
    }
  }

  .mobile-bar-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-text);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-sleek);
    text-transform: uppercase;
    font-weight: 700;
    transition: background var(--duration-fast);
  }

  .mobile-bar-btn--wa {
    background: #25D366;
    color: var(--canvas);
  }

  .mobile-bar-btn--wa:hover {
    background: #1ebe59;
  }

  .mobile-bar-btn--book {
    background: var(--iron);
    color: var(--canvas);
  }

  .mobile-bar-btn--book:hover {
    background: var(--agency-red);
  }
</style>
