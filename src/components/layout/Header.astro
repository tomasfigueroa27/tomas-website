---
const navLinks = [
  { label: 'New Developments', href: '/new-developments/' },
  { label: 'Properties',       href: '/properties/' },
  { label: 'Neighborhoods',    href: '/neighborhoods/' },
  { label: 'Guides',           href: '/guides/' },
  { label: 'Market',           href: '/market-reports/' },
  { label: 'About',            href: '/about/' },
  { label: 'Contact',          href: '/contact/' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header" id="site-header">
  <div class="header-inner container">
    <!-- Logo -->
    <a href="/" class="header-logo" aria-label="The Agency Roatán – Home">
      <!-- TODO: replace with <img> once Agency logo SVG is supplied -->
      <span class="logo-wordmark">
        <span class="logo-the">THE</span><span class="logo-agency">AGENCY</span>
      </span>
      <span class="logo-location">ROATÁN</span>
    </a>

    <!-- Desktop nav -->
    <nav class="header-nav" aria-label="Main navigation">
      <ul class="nav-list">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class:list={['nav-link', { 'nav-link--active': currentPath.startsWith(link.href) }]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Hamburger (always visible — opens mobile drawer) -->
    <button
      class="hamburger"
      aria-controls="mobile-nav"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- Mobile nav drawer -->
  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden>
    <ul>
      {navLinks.map(link => (
        <li><a href={link.href} class="mobile-nav-link">{link.label}</a></li>
      ))}
      <li>
        <a
          href="https://wa.me/50499999999"
          class="mobile-nav-link mobile-nav-whatsapp"
          target="_blank"
          rel="noopener noreferrer"
          data-event="whatsapp_click"
        >
          WhatsApp
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header') as HTMLElement;
  const hamburger = document.querySelector('.hamburger') as HTMLButtonElement;
  const mobileNav = document.getElementById('mobile-nav');

  // Mobile drawer toggle
  if (hamburger && mobileNav) {
    hamburger.addEventListener('click', () => {
      const open = hamburger.getAttribute('aria-expanded') === 'true';
      hamburger.setAttribute('aria-expanded', String(!open));
      mobileNav.hidden = open;
    });
  }

  // Scroll behavior: transparent → red → hidden → red (on scroll up)
  let lastY = 0;
  let ticking = false;

  function updateHeader() {
    const y = window.scrollY;

    // Transparent at top, red after 60px
    if (y > 60) {
      header.classList.add('scrolled');
    } else {
      header.classList.remove('scrolled');
    }

    // Hide on scroll down past 300px, reveal on scroll up
    if (y > 300) {
      if (y > lastY) {
        header.classList.add('header-hidden');
      } else {
        header.classList.remove('header-hidden');
      }
    } else {
      header.classList.remove('header-hidden');
    }

    lastY = y;
    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(updateHeader);
      ticking = true;
    }
  }, { passive: true });

  // WhatsApp GA4 tracking
  document.querySelectorAll('[data-event="whatsapp_click"]').forEach(el => {
    el.addEventListener('click', () => {
      if (typeof gtag !== 'undefined') {
        gtag('event', 'whatsapp_click', { event_category: 'engagement' });
      }
    });
  });
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-nav);
    height: var(--nav-height);
    background: transparent;
    transition: background 0.3s ease, transform 0.3s ease;
  }

  /* Solid red once user has scrolled past the hero */
  .site-header.scrolled {
    background: var(--agency-red);
  }

  /* Slide up when scrolling down deep into the page */
  .site-header.header-hidden {
    transform: translateY(-100%);
  }

  .header-inner {
    display: flex;
    align-items: center;
    height: 100%;
    gap: var(--space-8);
  }

  /* ── Logo ── */
  .header-logo {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    line-height: 1;
    gap: 2px;
    text-decoration: none;
  }

  .logo-wordmark {
    display: block;
    font-family: var(--font-sleek);
    font-size: var(--text-xl);
    letter-spacing: 0.04em;
    color: var(--canvas);
  }

  .logo-the {
    font-weight: 300;
  }

  .logo-agency {
    font-weight: 700;
  }

  .logo-location {
    display: block;
    font-family: var(--font-text);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-sleek);
    color: rgba(255,255,255,.65);
    text-transform: uppercase;
  }

  /* ── Desktop nav ── */
  .header-nav {
    flex: 1;
    display: none;
  }

  @media (min-width: 1024px) {
    .header-nav { display: block; }
  }

  .nav-list {
    display: flex;
    gap: var(--space-7);
    align-items: center;
    justify-content: flex-end;
    list-style: none;
  }

  .nav-link {
    font-family: var(--font-text);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-sleek);
    text-transform: uppercase;
    color: rgba(255,255,255,.80);
    transition: color var(--duration-fast);
    white-space: nowrap;
  }

  .nav-link:hover,
  .nav-link--active {
    color: var(--canvas);
  }

  /* ── Hamburger ── */
  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-2);
    margin-left: var(--space-4);
    flex-shrink: 0;
  }

  .hamburger span {
    display: block;
    width: 24px;
    height: 1.5px;
    background: var(--canvas);
    transition: background var(--duration-fast);
  }

  /* ── Mobile drawer ── */
  .mobile-nav {
    position: fixed;
    top: var(--nav-height);
    left: 0;
    right: 0;
    background: var(--agency-red);
    padding: var(--space-8) var(--gutter) var(--space-10);
    z-index: var(--z-nav);
    border-top: 1px solid rgba(255,255,255,.15);
  }

  .mobile-nav ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    list-style: none;
  }

  .mobile-nav-link {
    font-family: var(--font-text);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-sleek);
    text-transform: uppercase;
    color: rgba(255,255,255,.85);
    transition: color var(--duration-fast);
  }

  .mobile-nav-link:hover {
    color: var(--canvas);
  }

  .mobile-nav-whatsapp {
    color: var(--canvas);
    font-weight: 700;
  }
</style>
