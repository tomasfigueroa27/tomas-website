---
export interface Props {
  status: 'coming-soon' | 'pre-sale' | 'under-construction' | 'delivered';
}

const { status } = Astro.props;

const labels: Record<string, string> = {
  'coming-soon': 'Coming Soon',
  'pre-sale': 'Pre-Sale',
  'under-construction': 'Under Construction',
  'delivered': 'Delivered',
};
---

<span class:list={['badge', `badge--${status}`]}>{labels[status]}</span>

<style>
  .badge {
    display: inline-block;
    font-family: var(--font-text);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-sleek);
    text-transform: uppercase;
    padding: 0.25em 0.75em;
  }

  .badge--coming-soon       { background: var(--plaster); color: var(--iron-60); }
  .badge--pre-sale          { background: var(--iron); color: var(--canvas); }
  .badge--under-construction { background: #f5a623; color: var(--iron); }
  .badge--delivered         { background: #2e7d32; color: var(--canvas); }
</style>
